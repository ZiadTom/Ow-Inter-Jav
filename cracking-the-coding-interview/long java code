public class ExampleCode {

    // High Cyclomatic Complexity
    public void complexMethod(int value) {
        if (value > 10) {
            for (int i = 0; i < value; i++) {
                if (i % 2 == 0) {
                    System.out.println("Even number: " + i);
                } else if (i % 3 == 0) {
                    System.out.println("Divisible by 3: " + i);
                } else {
                    System.out.println("Other: " + i);
                }
            }
        } else {
            while (value > 0) {
                value--;
                System.out.println("Decrementing value: " + value);
            }
        }
    }

    // Static method with private visibility
    private static void helperMethod() {
        System.out.println("This is a helper method.");
    }

    // Method with parameters
    public void methodWithParameters(String param1, int param2, double param3) {
        System.out.println("Parameters: " + param1 + ", " + param2 + ", " + param3);
    }

    // Private attribute
    private String hiddenAttribute;
